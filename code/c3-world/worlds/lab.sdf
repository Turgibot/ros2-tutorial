<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lab">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.85 0.9 0.95 1</background></scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.2 -0.9</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- the table: a solid box 0.6 m (x) by 0.9 m (y), 0.30 m high; its top is at z = 0.30 -->
    <model name="table">
      <static>true</static>
      <pose>0.65 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.9 0.3</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.9 0.3</size></box></geometry>
          <material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://block_A</uri>
      <pose>0.60 -0.18 0.325 0 0 0</pose>
    </include>

    <include>
      <uri>model://block_B</uri>
      <pose>0.60 -0.06 0.325 0 0 0</pose>
    </include>

    <include>
      <uri>model://block_C</uri>
      <pose>0.60 0.06 0.325 0 0 0</pose>
    </include>

    <include>
      <uri>model://block_D</uri>
      <pose>0.60 0.18 0.325 0 0 0</pose>
    </include>

    <!-- a camera 1.2 m above the table, looking straight down -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.65 0 1.3 0 1.5708 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>5</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>overhead_camera/image</topic>
        </sensor>
      </link>
    </model>
    <!-- a second camera, to the side, looking at the blocks from an angle -->
    <model name="side_camera">
      <static>true</static>
      <pose>0.15 -0.5 0.62 0 0.43 0.74</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>5</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>side_camera/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
